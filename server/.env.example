# Copy to .env and fill in. Never commit .env.
# Validated at boot by src/env.ts — the process exits if anything required is missing.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# SQLite for now. On the MySQL switch this becomes:
#   DATABASE_URL="mysql://user:password@localhost:3306/dn_backend"
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# CORS — comma-separated origins allowed to POST forms.
# Must list the real frontend origin in production; "*" is rejected at boot there.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Anti-bot
# RECAPTCHA_SECRET_KEY empty => verification is SKIPPED (dev only).
# Submissions below the threshold are stored and flagged, never dropped.
# ---------------------------------------------------------------------------
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5

# Minimum seconds between form render and submit. Faster than this is a bot.
MIN_SUBMIT_SECONDS=3

# Rate limit per IP
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=1 hour

# Block personal email domains on lead forms (footer/newsletter is exempt)
BLOCK_FREE_EMAIL_DOMAINS=true

# ---------------------------------------------------------------------------
# Public URLs — used to build unsubscribe links
# ---------------------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Deferred integrations. All optional; each logs its intent until configured.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
CALENDAR_BOOKING_URL=
CRM_PROVIDER=
CRM_API_KEY=

# Run the job worker inside the API process. Set false only when running a
# dedicated worker process, or the same job gets claimed twice.
RUN_WORKER=true
