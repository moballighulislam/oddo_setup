    {
      "name": "Idempotency",
      "item": [
        {
          "name": "07a First submission (saves the uuid)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate one uuid and keep it, so the replay request can reuse it.",
                  "pm.collectionVariables.set('replayUuid', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('firstSubmissionId', pm.response.json().submission_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submission_uuid\": \"{{replayUuid}}\",\n  \"form_name\": \"site_footer\",\n  \"email\": \"duplicate.test@acme-corp.com\",\n  \"consent_given\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/forms/footer_form/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "footer_form",
                "submit"
              ]
            },
            "description": "Run this FIRST. It stores the generated uuid in a collection variable so the next request can replay it."
          }
        },
        {
          "name": "07b Replay same uuid (must not create a second lead)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replay accepted', () => pm.response.to.have.status(200));",
                  "pm.test('returns the ORIGINAL submission id', () => {",
                  "  pm.expect(pm.response.json().submission_id)",
                  "    .to.eql(pm.collectionVariables.get('firstSubmissionId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submission_uuid\": \"{{replayUuid}}\",\n  \"form_name\": \"site_footer\",\n  \"email\": \"duplicate.test@acme-corp.com\",\n  \"consent_given\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/forms/footer_form/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "footer_form",
                "submit"
              ]
            },
            "description": "Run AFTER 07a. Same submission_uuid, so this is a double-click or a network retry.\n\nReturns the original submission_id and creates no second lead."
          }
        }
      ]
    },
