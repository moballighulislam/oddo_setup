{
  "info": {
    "name": "dn-backend — GRC webforms",
    "description": "Form intake API for the GRC SaaS marketing site.\n\nIMPORT AND RUN — no setup needed beyond starting the server (`npm run dev`).\n\nEvery submission uses Postman's `{{$guid}}` variable for `submission_uuid`, so each send generates a fresh idempotency key automatically. The 'Idempotency' folder is the exception — it deliberately reuses one to prove a replay creates no second lead.\n\nRate limit is 5 per IP per hour. To run the whole collection, start the server with RATE_LIMIT_MAX=500.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "replayUuid",
      "value": "",
      "type": "string",
      "description": "Set by the Idempotency > First submission request, reused by the replay."
    },
    {
      "key": "unsubscribeToken",
      "value": "PASTE_TOKEN_HERE",
      "type": "string",
      "description": "From newsletter_subscribers.unsubscribe_token — find it with `npx prisma studio`."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Pings the database and reports queue depth. Returns 503 when the database is unreachable.\n\nA rising `pending` count means the worker is behind. Any `dead` count needs a human."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('service is up', () => pm.response.to.have.status(200));",
                  "pm.test('database reachable', () => {",
                  "  pm.expect(pm.response.json().checks.database).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            },
            "description": "Liveness only, no dependency checks. For container restart policies."
          }
        }
      ]
    },
    {
      "name": "Forms",
      "item": [
        {
          "name": "01 Quick capture (homepage popup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submission_uuid\": \"{{$guid}}\",\n  \"form_name\": \"homepage_popup\",\n\n  \"full_name\": \"Jane Okonkwo\",\n  \"email\": \"jane.okonkwo@stellar-payments.com\",\n  \"phone\": \"+1 212 456 7890\",\n  \"company_name\": \"Stellar Payments\",\n\n  \"consent_given\": true,\n  \"consent_text_version\": \"v1\",\n\n  \"utm_source\": \"google\",\n  \"utm_medium\": \"cpc\",\n  \"utm_campaign\": \"grc_q4\",\n  \"page_url\": \"/platform\",\n  \"referrer_url\": \"https://www.google.com/\",\n  \"landing_page\": \"/platform\",\n  \"session_id\": \"sess_a8f3c9d2\",\n  \"pages_viewed\": 4,\n  \"visit_count\": 2,\n  \"visited_pricing\": true,\n  \"device_type\": \"desktop\",\n\n  \"form_render_ms\": 32000,\n  \"website\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/forms/quick_capture/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forms",
                "quick_capture",
                "submit"
              ]
            },
            "description": "The 4-field template, used for the homepage popup and the solutions banner.\n\nPhone is OPTIONAL here — a deliberate deviation from the spec. GRC buyers withhold a phone number on a first popup, and qualification happens on the sales call anyway.\n\n`website` is the honeypot: leave it empty."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted', () => pm.response.to.have.status(200));",
                  "pm.test('returns an id', () => {",
                  "  pm.expect(pm.response.json().submission_id).to.be.a('string');",
                  "});",
                  "pm.test('does not leak sales intelligence', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.not.have.property('score');",
                  "  pm.expect(b).to.not.have.property('routing_tier');",
                  "});"
                ]
              }
            }
          ]
        },
        {
